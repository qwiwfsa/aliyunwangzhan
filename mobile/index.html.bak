                            </div>
                        </details></div>
                </div>
                
                <div class="faq-category" style="opacity: 1; transform: translateY(0px); transition: opacity 0.5s, transform 0.5s;">
                    <h3 class="faq-category-title"><i class="fas fa-file-invoice-dollar" aria-hidden="true"></i> 搴旀敹璐︽铻嶈祫</h3>
                    <div class="faq-list">
                        <details class="faq-item">
                            <summary class="faq-question">浠€涔堟牱鐨勫簲鏀惰处娆惧彲浠ヨ瀺璧勶紵</summary>
                            <div class="faq-answer">
                                <p>涓€鑸潵璇达紝涓庢牳蹇冧紒涓氾紙鍥戒紒銆佸ぎ浼併€佷笂甯傚叕鍙哥瓑锛変骇鐢熺殑搴旀敹璐︽鏇村鏄撹幏寰楄瀺璧勩€傛垜浠帴鍙椾簯淇°€佸晢绁ㄧ瓑澶氱褰㈠紡鐨勫簲鏀惰处娆捐瀺璧勭敵璇枫€?/p>

                            </div>
                        </details>
                        <details class="faq-item">
                            <summary class="faq-question">浠€涔堟槸浜祫涓氬姟锛?/summary>

                            <div class="faq-answer">
                                <p>铻嶈祫棰濆害涓昏鏍规嵁搴旀敹璐︽閲戦銆佷粯娆炬柟淇＄敤绛夌骇銆佽处鏈熺瓑鍥犵礌缁煎悎璇勪及銆備竴鑸彲铻嶈祫閲戦涓哄簲鏀惰处娆鹃潰棰濈殑70%-95%銆?/p>

                            </div>
                        </details>
                    </div>
                </div>
            </div>
        </div>
    </section>

    </main>

    <!-- 鍙充晶杈规诞鍔ㄧ數璇濇寜?-->
    

    <!-- 椤佃剼 -->
    <footer class="footer">
        <div class="footer-container">
            <div class="footer-bottom">
                <p class="footer-copyright">漏 2024 Yao璧勯噾?鐗堟潈鎵€鏈夈€?/p>
                <p class="footer-disclaimer">鎶曡祫鏈夐闄╋紝鐞嗚储闇€璋ㄦ厧銆傛湰缃戠珯鍐呭浠呬緵鍙傝€冿紝涓嶆瀯鎴愭姇璧勫缓璁€?/p>
            </div>
        </div>
    </footer>

    <script src="../js/main.js"></script>
    
    <!-- CMS Data Integration -->
    <script src="../admin/assets/cms.js"></script>
    
    <!-- 鎴愬姛妗堜緥灞曠ず鑴氭湰 -->
    <script>
        // 鎴愬姛妗堜緥灞曠ず妯″潡
        (function() {
            let casesData = [];
            let currentPage = 1;
            const itemsPerPage = 8;
            
            // 浠庡悗绔疉PI鑾峰彇妗堜緥鏁版嵁
            async function fetchCases() {
                try {
                    console.log('[棣栭〉妗堜緥] 寮€濮嬭幏鍙栨渚嬫暟鎹?..');

                    // 浣跨敤姝ｇ‘鐨凙PI璺緞锛屾坊鍔犳椂闂存埑闃叉缂撳瓨
                    const response = await fetch('../api/cases.php?t=' + Date.now(), {
                        method: 'GET',
                        headers: {
                            'Accept': 'application/json',
                            'Cache-Control': 'no-cache'
                        }
                    });
                    
                    // 妫€鏌ュ搷搴旂被?                    const contentType = response.headers.get('content-type');
                    if (!contentType || !contentType.includes('application/json')) {
                        const text = await response.text();
                        console.error('[棣栭〉妗堜緥] API杩斿洖闈濲SON鏍煎紡:', text.substring(0, 200));
                        showEmptyState();
                        return;
                    }
                    
                    const result = await response.json();
                    console.log('[棣栭〉妗堜緥] API杩斿洖:', result);
                    
                    if (result.success && result.cases && result.cases.length > 0) {
                        // API杩斿洖鐨勬槸 cases 瀛楁锛屼笉鏄痙ata 瀛楁

                        // 鎸塈D鍘婚噸锛岄槻姝㈤噸澶嶆樉?                        const seenIds = new Set();
                        const uniqueCases = result.cases.filter(c => {
                            if (seenIds.has(c.id)) {
                                console.log('[棣栭〉妗堜緥] 鍘婚噸璺宠繃閲嶅妗堜緥:', c.id, c.title);
                                return false;
                            }
                            seenIds.add(c.id);
                            return true;
                        });
                        
                        casesData = uniqueCases.map(c => ({
                            id: c.id,
                            title: c.title,
                            summary: c.summary || '鏆傛棤绠€浠?,

                            amount: c.amount || '淇濆瘑',
                            cover_image: c.coverImage ? '/hongdu/' + c.coverImage : (c.image ? '/hongdu/' + c.image : '../images/case-default.svg')
                        }));
                    console.log('[棣栭〉妗堜緥] 寮€濮嬭幏鍙栨渚嬫暟鎹?..');

                        renderCases();
                        updatePagination();
                    } else {
                        console.log('[棣栭〉妗堜緥] 鏃犳渚嬫暟鎹垨API杩斿洖澶辫触');
                        showEmptyState();
                    }
                } catch (error) {
                    console.error('[棣栭〉妗堜緥] 鑾峰彇妗堜緥鏁版嵁澶辫触:', error);
                    showEmptyState();
                }
            }
            
            // 娓叉煋妗堜緥鍗＄墖
            function renderCases() {
                const grid = document.getElementById('casesShowcaseGrid');
                if (!grid) return;
                
                const startIndex = (currentPage - 1) * itemsPerPage;
                const endIndex = startIndex + itemsPerPage;
                const pageData = casesData.slice(startIndex, endIndex);
                
                if (pageData.length === 0) {
                    showEmptyState();
                    return;
                }
                
                grid.innerHTML = pageData.map(item => `
                    <article class="case-card-enhanced" data-id="${item.id}">
                        <div class="case-card-image" onclick="openLightbox('${item.cover_image}')">
                            <img src="${item.cover_image}"
                                 alt="${item.title}"
                                 onerror="this.src='../images/case-default.svg'">
                        </div>
                        <div class="case-card-content">
                            <h3 class="case-card-title">${item.title}</h3>
                            <p class="case-card-summary">${item.summary}</p>
                            <div class="case-card-meta">
                                <div class="case-card-amount">
                                    <span class="case-card-amount-label">鍑鸿祫閲戦</span>
                                    <span class="case-card-amount-value">${item.amount}</span>
                                </div>
                                <button class="btn-view-detail" style="pointer-events: none; opacity: 0.6; cursor: default;">鏌ョ湅璇︽儏</button>
                            </div>
                        </div>
                    </article>
                `).join('');
            }
            
            // 鏄剧ず绌虹姸?            function showEmptyState() {
                const grid = document.getElementById('casesShowcaseGrid');
                if (grid) {
                    grid.innerHTML = `
                        <div class="cases-showcase-empty">
                            <i class="fas fa-folder-open"></i>
                            <p class="cases-showcase-empty-text">鏆傛棤鎴愬姛妗堜緥锛屾暚璇锋湡寰?/p>

                        </div>
                    `;
                }
            }
            
            // 鏇存柊鍒嗛〉?            function updatePagination() {
                const totalPages = Math.ceil(casesData.length / itemsPerPage);
                const prevBtn = document.getElementById('prevPageBtn');
                const nextBtn = document.getElementById('nextPageBtn');
                const pageInfo = document.getElementById('paginationInfo');
                
                if (prevBtn) prevBtn.disabled = currentPage <= 1;
                if (nextBtn) nextBtn.disabled = currentPage >= totalPages || totalPages === 0;
                if (pageInfo) pageInfo.textContent = `绗?{currentPage} 椤?/ 鍏?{totalPages || 1} 椤礰;

                
                // 濡傛灉鎬婚〉鏁颁负1锛岄殣钘忓垎?                const paginationContainer = document.getElementById('casesShowcasePagination');
                if (paginationContainer) {
                    paginationContainer.style.display = totalPages <= 1 ? 'none' : 'flex';
                }
            }
            
            // 鍒囨崲椤甸潰
            window.changePage = function(direction) {
                const totalPages = Math.ceil(casesData.length / itemsPerPage);
                const newPage = currentPage + direction;
                
                if (newPage >= 1 && newPage <= totalPages) {
                    currentPage = newPage;
                    renderCases();
                    updatePagination();
                    // 婊氬姩鍒版渚嬪尯鍩熼《?                    document.getElementById('casesShowcase').scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            };
            
            // 鎵撳紑鍥剧墖棰勮
            window.openLightbox = function(imageSrc) {
                const lightbox = document.getElementById('imageLightbox');
                const lightboxImage = document.getElementById('lightboxImage');
                lightboxImage.src = imageSrc;
                lightbox.style.display = 'flex';
                document.body.style.overflow = 'hidden'; // 绂佹鑳屾櫙婊氬姩
            };
            
            // 鍏抽棴鍥剧墖棰勮
            window.closeLightbox = function() {
                const lightbox = document.getElementById('imageLightbox');
                lightbox.style.display = 'none';
                document.body.style.overflow = ''; // 鎭㈠鑳屾櫙婊氬姩
            };
            
            // 鐐瑰嚮鑳屾櫙鍏抽棴
            document.addEventListener('click', function(e) {
                const lightbox = document.getElementById('imageLightbox');
                if (e.target === lightbox) {
                    closeLightbox();
                }
            });
            
            // ESC閿叧闂?           document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') {
                    closeLightbox();
                }
            });
            
            // 椤甸潰鍔犺浇瀹屾垚鍚庡垵濮嬪寲
            document.addEventListener('DOMContentLoaded', fetchCases);
        })();
    </script>
    
    <!-- 鍥剧墖棰勮寮圭獥 (Lightbox) -->
    <div id="imageLightbox" class="lightbox-overlay" style="display: none;">
        <div class="lightbox-container">
            <button class="lightbox-close" onclick="closeLightbox()" aria-label="鍏抽棴棰勮">
                <i class="fas fa-times"></i>
            </button>
            <img id="lightboxImage" src="" alt="澶у浘棰勮">
        </div>
    </div>

    <!-- Lightbox 鏍峰紡 -->
    <style>
        .lightbox-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.9);
            z-index: 9999;
            display: flex;
            align-items: center;
            justify-content: center;
            animation: fadeIn 0.3s ease;
        }
        
        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }
        
        .lightbox-container {
            position: relative;
            max-width: 90%;
            max-height: 90%;
        }
        
        .lightbox-container img {
            max-width: 100%;
            max-height: 90vh;
            object-fit: contain;
            border-radius: 4px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
        }
        
        .lightbox-close {
            position: absolute;
            top: -50px;
            right: 0;
            width: 40px;
            height: 40px;
            background: rgba(255, 255, 255, 0.2);
            border: none;
            border-radius: 50%;
            color: white;
            font-size: 20px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background 0.3s ease;
        }
        
        .lightbox-close:hover {
            background: rgba(255, 255, 255, 0.4);
        }
        
        /* 鐐瑰嚮鍥剧墖鐨勬寚閽堟牱?*/
        .case-card-image {
            cursor: pointer;
        }
        
        .case-card-image img {
            transition: transform 0.3s ease;
        }
        
        .case-card-image:hover img {
            transform: scale(1.05);
        }
    </style>

    <!-- 璁块棶缁熻浠ｇ爜 -->
    <script>
        // 缃戠珯璁块棶缁熻
        (function() {
            // 闃叉閲嶅璁板綍?            if (window.statsTracked) return;
            window.statsTracked = true;
            
            // 鑾峰彇褰撳墠椤甸潰URL
            const pageUrl = window.location.href;
            
            // 鑾峰彇鏉ユ簮椤甸潰
            const referer = document.referrer || '';
            
            // 鍙戦€佽闂粺璁¤?            function sendStats() {
                const statsData = {
                    action: 'record',
                    page_url: pageUrl,
                    referer: referer
                };
                
                // 浣跨敤fetch鍙戦€丳OST璇锋眰
                fetch('admin/api/stats.php', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded'
                    },
                    body: new URLSearchParams(statsData).toString()
                }).then(response => response.json())
                  .then(data => {
                      console.log('[Stats] 璁胯闂粺璁″凡璁板綍?', data);

                  }).catch(error => {
                      console.log('[Stats] 缁熻璁板綍澶辫触:', error);
                  });
            }
            
            // 椤甸潰鍔犺浇瀹屾垚鍚庡彂閫佺粺璁?           if (document.readyState === 'complete') {
                sendStats();
            } else {
                window.addEventListener('load', sendStats);
            }
        })();
    </script>

    <!-- CMS Editor -->
    <script>
        // 妫€鏌ユ槸鍚﹂渶瑕佸姞杞界紪杈戝櫒
        (function() {
            console.log('[CMS] 鍒濆鍖栨鏌?..');

            
            const urlParams = new URLSearchParams(window.location.search);
            const isEditMode = urlParams.get('edit') === 'true';
            const isLoggedIn = localStorage.getItem('cms_logged_in') === 'true';
            
            console.log('[CMS] 缂栬緫妯″紡:', isEditMode);
            console.log('[CMS] 鍒濆鍖栨鏌?..');

            console.log('[CMS] localStorage cms_logged_in:', localStorage.getItem('cms_logged_in'));
            
            if (isEditMode && isLoggedIn) {
                console.log('[CMS] 寮€濮嬪姞杞界紪杈戝櫒...');
                
                // 鍔犺浇缂栬緫鍣ㄦ牱?                const editorCss = document.createElement('link');
                editorCss.rel = 'stylesheet';
                editorCss.href = 'admin/editor.css';
                editorCss.onerror = function() {
                        console.error('[棣栭〉妗堜緥] API杩斿洖闈濲SON鏍煎紡:', text.substring(0, 200));

                    alert('CMS缂栬緫鍣ㄦ牱寮忓姞杞藉け璐ワ紝璇锋鏌ユ枃浠惰矾寰?);

                };
                document.head.appendChild(editorCss);
                console.log('[CMS] 鏍峰紡琛ㄥ凡鍔犺浇');
                
                // 鍔犺浇缂栬緫鍣ㄨ剼?                const editorScript = document.createElement('script');
                editorScript.src = 'admin/editor.js';
                editorScript.onload = function() {
            console.log('[CMS] 鍒濆鍖栨鏌?..');

                };
                editorScript.onerror = function() {
                        console.error('[棣栭〉妗堜緥] API杩斿洖闈濲SON鏍煎紡:', text.substring(0, 200));

                    alert('CMS缂栬緫鍣ㄨ剼鏈姞杞藉け璐ワ紝璇锋鏌ユ枃浠惰矾寰?);

                };
                document.body.appendChild(editorScript);
            } else if (isEditMode && !isLoggedIn) {
            console.log('[CMS] 鍒濆鍖栨鏌?..');

                // 鏈櫥褰曪紝閲嶅畾鍚戝埌鐧诲綍?                window.location.href = 'admin/login.html?redirect=' + encodeURIComponent(window.location.href);
            } else {
                console.log('[CMS] 涓嶅湪缂栬緫妯″紡鎴栨湭鐧诲綍');
            }
        })();
    </script>
    <script>
        // 鍒囨崲鐢佃瘽鍙风爜鏄剧ず锛氶殣钘忔寜閽紝鍘熷湴鏄剧ず鍙风爜
        function togglePhoneDisplay() {
            const btn = document.getElementById('consultNowBtn');
            const phone = document.getElementById('phoneDisplay');
            if (btn && phone) {
                btn.style.display = 'none';
                phone.style.display = 'inline-flex';
            }
        }

        // 鐐瑰嚮椤甸潰绌虹櫧澶勶細鎭㈠鎸夐挳锛岄殣钘忓彿鐮?
        document.addEventListener('click', function(e) {
            const btn = document.getElementById('consultNowBtn');
            const phone = document.getElementById('phoneDisplay');
            if (btn && phone && phone.style.display !== 'none') {
                // 鐐瑰嚮鐨勪笉鏄寜閽強鍏跺瓙鍏冪礌锛屼篃涓嶆槸鍙风爜鍙婂叾瀛愬厓绱犳椂闅愯棌鍙风爜
                if (e.target !== btn && !btn.contains(e.target) &&
                    e.target !== phone && !phone.contains(e.target)) {
                    phone.style.display = 'none';
                    btn.style.display = 'inline-flex';
                }
            }
        });
    </script>




</body></html>
